# Flask Configuration
FLASK_SECRET_KEY=dev_secret_key_change_me
FLASK_DEBUG=True

# LLM Configuration
# Choose between: gemini, ollama, or none
LLM_PROVIDER=none

# Gemini API Key (Required if LLM_PROVIDER is gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (Required if LLM_PROVIDER is ollama)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
